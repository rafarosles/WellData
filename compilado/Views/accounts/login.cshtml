                                        <input type="hidden" name="csrfmiddlewaretoken" value="DJTl5o3LelWcbtn86Jdy6Xq80cbpb0usVeg7HDN1yi6173GB1aP8AzJDRJLb1hxG">
                                        <input name="next" type="hidden" value="/">
                                        <!-- <select class="custom-select form-control-sm" type="button" name="language" onchange="this.form.submit();">




                                        <option value="es-mx" >
                                           Mexican Spanish (es-mx)
                                        </option>

                                        <option value="en"  selected >
                                           English (en)
                                        </option>

                                        </select> -->
                                    </form>
                                </div>
                            </div>


                            <form class="kt-login-v2__form kt-form" method="post" autocomplete="off" id="form-validar-usuario">
                                <div id="mensaje-error-usuario"></div>
                                <input type="hidden" name="csrfmiddlewaretoken" value="DJTl5o3LelWcbtn86Jdy6Xq80cbpb0usVeg7HDN1yi6173GB1aP8AzJDRJLb1hxG">



                                <div class="cjs-center-login">
                                    <div class="form-group margin-bottom-30px">
                                        <input ng-model="ctrl.username" class="form-control" type="text" placeholder="Correo" name="username" autocomplete="off" id="username">
                                    </div>
                                    <div class="form-group">
                                        <input ng-model="ctrl.password"  class="form-control" type="password" placeholder="Contraseña" name="password" autocomplete="off" id="password">
                                    </div>
                                </div>
                                <!--begin::Action-->
                                <div class="kt-login-v2__actions">
                                    <a href="#" class="kt-link kt-link--brand-hover">
                                        @*Forgot Password ?*@
                                    </a>
                                    <a class="btn btn-brand-2" ng-click="ctrl.iniciar_sesion()" id="login">Iniciar Sesión</a>
                                </div>

